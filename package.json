{
  "name": "pi-lsp",
  "version": "0.0.48-clangd-ty.1",
  "description": "Fork of @spences10/pi-lsp 0.0.48 with clangd (C/C++) and ty (Python) support.",
  "keywords": [
    "language-server",
    "lsp",
    "pi",
    "pi-package"
  ],
  "homepage": "https://github.com/csaez/pi-lsp#readme",
  "license": "MIT",
  "author": "Scott Spence <me@scottspence.com> (original)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/csaez/pi-lsp.git"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@spences10/pi-child-env": "0.1.10",
    "@spences10/pi-project-trust": "0.0.19",
    "@spences10/pi-tui-modal": "0.0.24"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.0.0",
    "@types/node": "^22",
    "typescript": "^5.9",
    "vitest": "^3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=22"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  }
}

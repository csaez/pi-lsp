{
  "name": "pi-lsp",
  "version": "0.0.32-clangd-ty.1",
  "description": "Language Server Protocol tools for Pi agents - forked from @spences10/pi-lsp with clangd (C++) and ty (Python) support added.",
  "keywords": [
    "language-server",
    "lsp",
    "pi",
    "pi-package"
  ],
  "homepage": "https://github.com/spences10/my-pi/tree/main/packages/pi-lsp#readme",
  "license": "MIT",
  "author": "Scott Spence <me@scottspence.com> (original)",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=22"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  }
}
